#!/usr/bin/env python3
# Kimi Code weekly quota for Conky. Usage: kimi-quota percent|remaining|days
# Fetches {api}/coding/v1/usages at most once per TTL seconds (cache in
# ~/.cache/kimi-quota.json); on fetch failure serves the last good cache.
# OAuth: ~/.kimi-code/credentials/kimi-code.json. The access token lives
# ~15 min, so unlike grok-quota/codex-quota this script refreshes it itself
# via POST {auth}/api/oauth/token (same flow the CLI uses) and writes the
# new tokens back. If refresh is rejected (invalid_grant), run `kimi /login`.
# Endpoint details reverse-engineered from ~/.kimi-code/bin/kimi.

import json
import sys
import time
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

TTL = 240  # seconds between network fetches
CACHE = Path.home() / ".cache" / "kimi-quota.json"
CREDS = Path.home() / ".kimi-code" / "credentials" / "kimi-code.json"
REGION = Path.home() / ".kimi-code" / "region"
CLIENT_ID = "17e5f671-d194-4dfb-9706-5516cb48c098"


def hosts() -> tuple[str, str]:
    try:
        region = REGION.read_text().strip()
    except OSError:
        region = ""
    if region == "global":
        return "https://auth.kimi.ai", "https://api.kimi.ai"
    return "https://auth.kimi.com", "https://api.kimi.com"


def fresh_token(auth_host: str) -> str:
    creds = json.loads(CREDS.read_text())
    now = time.time()
    if creds.get("expires_at", 0) - now > 60:
        return creds["access_token"]

    body = urllib.parse.urlencode({
        "client_id": CLIENT_ID,
        "grant_type": "refresh_token",
        "refresh_token": creds["refresh_token"],
    }).encode()
    req = urllib.request.Request(
        f"{auth_host}/api/oauth/token",
        data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=8) as resp:
        data = json.loads(resp.read())

    creds["access_token"] = data["access_token"]
    if data.get("refresh_token"):
        creds["refresh_token"] = data["refresh_token"]
    creds["expires_at"] = int(now + data.get("expires_in", 900))
    CREDS.write_text(json.dumps(creds, indent=2))
    CREDS.chmod(0o600)
    return creds["access_token"]


def fetch() -> dict:
    auth_host, api_host = hosts()
    req = urllib.request.Request(
        f"{api_host}/coding/v1/usages",
        headers={"Authorization": f"Bearer {fresh_token(auth_host)}", "Accept": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=8) as resp:
        payload = json.loads(resp.read())

    # Top-level "usage" is the plan (weekly) quota; "limits" holds the
    # rolling rate windows (e.g. 300-minute burst). Fall back to a
    # week-ish rate window if "usage" is absent.
    usage = payload.get("usage") or {}
    if not usage.get("limit"):
        for row in payload.get("limits") or []:
            w = row.get("window") or {}
            detail = row.get("detail") or {}
            if detail.get("limit") and (w.get("timeUnit") == "TIME_UNIT_WEEK" or w.get("duration", 0) >= 1440):
                usage = detail
                break
    if not usage.get("limit"):
        raise ValueError("no usage window in response")

    secs = 0.0
    if usage.get("resetTime"):
        dt = datetime.fromisoformat(usage["resetTime"].replace("Z", "+00:00"))
        secs = max(0.0, (dt - datetime.now(timezone.utc)).total_seconds())

    return {
        "percent": int(usage.get("used") or 0) / int(usage["limit"]) * 100,
        "reset_secs": secs,
        "fetched_at": time.time(),
    }


def load() -> dict | None:
    try:
        cached = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        cached = None

    if cached and time.time() - cached.get("fetched_at", 0) < TTL:
        return cached

    try:
        data = fetch()
    except Exception:
        return cached  # stale beats nothing

    CACHE.parent.mkdir(parents=True, exist_ok=True)
    CACHE.write_text(json.dumps(data))
    CACHE.chmod(0o600)
    return data


def fmt_remaining(secs: float) -> str:
    days, rem = divmod(int(secs), 86400)
    hours = rem // 3600
    if days >= 2:
        return f"{days} days to reset"
    if days == 1:
        return f"1 day {hours}h to reset"
    return f"{hours}h to reset"


def main() -> None:
    mode = sys.argv[1] if len(sys.argv) > 1 else "percent"
    data = load()

    if data is None:
        print(0 if mode == "percent" else "?")
        return

    if mode == "percent":
        print(f"{data['percent']:.0f}")
    elif mode == "remaining":
        print(fmt_remaining(data["reset_secs"]))
    elif mode == "days":
        secs = data["reset_secs"]
        days = int(secs // 86400)
        print(f"{days:02d}d" if days > 0 else f"{int(secs // 3600):02d}h")
    else:
        sys.exit(f"unknown mode: {mode}")


if __name__ == "__main__":
    main()
