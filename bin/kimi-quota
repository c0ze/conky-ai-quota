#!/usr/bin/env python3
"""Kimi weekly usage for Conky: percent|remaining|days|color|status."""
from pathlib import Path
import sys
import time
from ai_quota_common import (
    MODES, authenticated_json, load_cache, number, percent, refresh_credentials,
    render, request_json, timestamp,
)

CACHE = Path.home() / ".cache/kimi-quota.json"
CREDS = Path.home() / ".kimi-code/credentials/kimi-code.json"
REGION = Path.home() / ".kimi-code/region"
CLIENT_ID = "17e5f671-d194-4dfb-9706-5516cb48c098"
UNIT_SECONDS = {"TIME_UNIT_SECOND": 1, "TIME_UNIT_MINUTE": 60,
                "TIME_UNIT_HOUR": 3600, "TIME_UNIT_DAY": 86400, "TIME_UNIT_WEEK": 604800}


def hosts():
    try:
        region = REGION.read_text().strip()
    except OSError:
        region = ""
    if region == "global":
        return "https://auth.kimi.ai", "https://api.kimi.ai"
    return "https://auth.kimi.com", "https://api.kimi.com"


def fresh_token(auth_host, force=False):
    def refresh(creds):
        data = request_json(f"{auth_host}/api/oauth/token", form=True, body={
            "client_id": CLIENT_ID, "grant_type": "refresh_token",
            "refresh_token": creds["refresh_token"],
        })
        updates = {"access_token": data["access_token"],
                   "expires_at": int(time.time() + number(data.get("expires_in", 900)))}
        if data.get("refresh_token"):
            updates["refresh_token"] = data["refresh_token"]
        return updates, {}
    return refresh_credentials(
        CREDS, None, "access_token", "refresh_token",
        lambda c: number(c.get("expires_at", 0)) - time.time() <= 60,
        refresh, force,
    )["access_token"]


def usage_percent(usage):
    limit = number(usage["limit"])
    if limit <= 0:
        raise ValueError("quota limit must be positive")
    if usage.get("used") is not None:
        used = number(usage["used"])
    elif usage.get("remaining") is not None:
        used = limit - number(usage["remaining"])
    else:
        raise ValueError("quota has neither used nor remaining")
    return percent(used / limit * 100)


def window_seconds(row):
    window = row.get("window") or {}
    return number(window.get("duration", 0)) * UNIT_SECONDS.get(window.get("timeUnit"), 0)


def parse_usage(payload):
    rows = payload.get("limits") or []
    usage = payload.get("usage") or {}
    if not usage.get("limit"):
        usage = next((r.get("detail") or {} for r in rows if window_seconds(r) == 604800), {})
    result = {"percent": usage_percent(usage), "reset_at": timestamp(usage.get("resetTime"))}
    short = min((r for r in rows if 0 < window_seconds(r) < 604800), key=window_seconds, default=None)
    if short:
        detail = short.get("detail") or {}
        result.update(short_percent=usage_percent(detail), short_reset_at=timestamp(detail.get("resetTime")))
    return result


def fetch():
    auth_host, api_host = hosts()
    return parse_usage(authenticated_json(
        f"{api_host}/coding/v1/usages", lambda force: fresh_token(auth_host, force),
    ))


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "percent"
    if mode not in MODES:
        sys.exit(f"unknown mode: {mode}")
    print(render(load_cache(CACHE, fetch), mode))


if __name__ == "__main__":
    main()
