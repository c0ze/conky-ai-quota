#!/usr/bin/env python3
# Codex weekly quota for Conky. Usage: codex-quota [profile] percent|remaining|days|color
#
# A profile selects a CODEX_HOME, so several ChatGPT accounts -- or several
# workspaces of one account -- can be tracked side by side:
#
#     default -> ~/.codex        gmail -> ~/.codex-gmail        pro -> ~/.codex-pro
#
# `codex-quota percent` (no profile) still means the default profile. CODEX_HOME
# from the environment overrides the default profile only; named profiles always
# resolve to their own directory, so a shell that exports CODEX_HOME cannot
# collapse every row onto one account.
#
# Fetches https://chatgpt.com/backend-api/wham/usage at most once per TTL
# seconds (cache in ~/.cache/codex-quota-<profile>.json); on fetch failure
# serves the last good cache.
# NOTE: the access token expires and only the `codex` CLI refreshes it, per
# home. If a row starts showing stale data, run `codex` once with that
# CODEX_HOME.
#
# The bar tracks the weekly window. `color` emits a conky colour: red once the
# short (5h) burst window is at ALERT_PERCENT or above. That burst limit is what
# actually blocks a session, and it is invisible in the weekly number.

import json
import os
import sys
import time
import urllib.request
from pathlib import Path

TTL = 240  # seconds between network fetches
WEEK = 604800
ALERT_PERCENT = 95
ALERT_COLOR = "${color #f38ba8}"
NORMAL_COLOR = "${color}"
MODES = ("percent", "remaining", "days", "color")


def codex_home(profile: str) -> Path:
    if profile == "default":
        return Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
    return Path.home() / f".codex-{profile}"


def cache_path(profile: str) -> Path:
    return Path.home() / ".cache" / f"codex-quota-{profile}.json"


def split_windows(rl: dict) -> tuple[dict | None, dict | None]:
    """Return (weekly, short) from a rate_limit block."""
    found = [w for w in (rl.get("primary_window"), rl.get("secondary_window")) if w]
    weekly = next(
        (w for w in found if abs((w.get("limit_window_seconds") or 0) - WEEK) < 10800),
        None,
    )
    others = [w for w in found if w is not weekly]
    short = min(others, key=lambda w: w.get("limit_window_seconds") or 0) if others else None
    if weekly is None:  # no weekly lane: fall back to the shortest window we have
        weekly, short = short, None
    return weekly, short


def fetch(profile: str) -> dict:
    tokens = json.loads((codex_home(profile) / "auth.json").read_text())["tokens"]
    headers = {
        "Authorization": f"Bearer {tokens['access_token']}",
        "Accept": "application/json",
        "User-Agent": "codex-cli",
    }
    if tokens.get("account_id"):
        headers["ChatGPT-Account-Id"] = tokens["account_id"]
    req = urllib.request.Request(
        "https://chatgpt.com/backend-api/wham/usage", headers=headers
    )
    with urllib.request.urlopen(req, timeout=8) as resp:
        rl = json.loads(resp.read()).get("rate_limit") or {}

    weekly, short = split_windows(rl)
    if not weekly:
        raise ValueError("no rate limit window in response")

    return {
        "percent": weekly.get("used_percent") or 0,
        "reset_secs": max(0, weekly.get("reset_after_seconds") or 0),
        "short_percent": (short.get("used_percent") or 0) if short else 0,
        "fetched_at": time.time(),
    }


def load(profile: str) -> dict | None:
    cache = cache_path(profile)
    try:
        cached = json.loads(cache.read_text())
    except (OSError, ValueError):
        cached = None

    if cached and time.time() - cached.get("fetched_at", 0) < TTL:
        return cached

    try:
        data = fetch(profile)
    except Exception:
        return cached  # stale beats nothing

    cache.parent.mkdir(parents=True, exist_ok=True)
    cache.write_text(json.dumps(data))
    cache.chmod(0o600)
    return data


def fmt_remaining(secs: float) -> str:
    days, rem = divmod(int(secs), 86400)
    hours = rem // 3600
    if days >= 2:
        return f"{days} days to reset"
    if days == 1:
        return f"1 day {hours}h to reset"
    return f"{hours}h to reset"


def main() -> None:
    args = sys.argv[1:]
    profile = args.pop(0) if args and args[0] not in MODES else "default"
    mode = args[0] if args else "percent"
    if mode not in MODES:
        sys.exit(f"unknown mode: {mode}")

    data = load(profile)

    if data is None:
        print({"percent": 0, "color": NORMAL_COLOR}.get(mode, "?"))
        return

    if mode == "percent":
        print(f"{data['percent']:.0f}")
    elif mode == "remaining":
        print(fmt_remaining(data["reset_secs"]))
    elif mode == "days":
        secs = data["reset_secs"]
        days = int(secs // 86400)
        print(f"{days:02d}d" if days > 0 else f"{int(secs // 3600):02d}h")
    elif mode == "color":
        hot = (data.get("short_percent") or 0) >= ALERT_PERCENT
        print(ALERT_COLOR if hot else NORMAL_COLOR)


if __name__ == "__main__":
    main()
