#!/usr/bin/env python3
"""Grok billing-period usage: percent|remaining|days|color|status."""
from datetime import datetime, timezone
import hashlib
import os
from pathlib import Path
import sys
import time
from ai_quota_common import (
    MODES, authenticated_json, jwt_expiry, load_cache, number, percent, read_json,
    refresh_credentials, render, request_json, timestamp,
)


def grok_home():
    return Path(os.environ.get("GROK_HOME") or Path.home() / ".grok")


def cache_path():
    source = grok_home().resolve()
    suffix = ""
    if source != (Path.home() / ".grok").resolve():
        suffix = "-" + hashlib.sha256(str(source).encode()).hexdigest()[:12]
    return Path.home() / ".cache" / f"grok-quota{suffix}.json"


def fresh_token(force=False):
    path = grok_home() / "auth.json"
    auth = read_json(path)
    entries = [k for k, v in auth.items() if isinstance(v, dict) and v.get("oidc_issuer") == "https://auth.x.ai"]
    if len(entries) != 1:
        raise ValueError("expected one xAI OAuth account")

    def refresh(creds):
        # Endpoint from https://auth.x.ai/.well-known/openid-configuration.
        data = request_json("https://auth.x.ai/oauth2/token", form=True, body={
            "client_id": creds["oidc_client_id"], "grant_type": "refresh_token",
            "refresh_token": creds["refresh_token"],
        })
        expires = time.time() + number(data.get("expires_in", 21600))
        updates = {
            "key": data["access_token"],
            "expires_at": datetime.fromtimestamp(expires, timezone.utc).isoformat().replace("+00:00", "Z"),
        }
        if data.get("refresh_token"):
            updates["refresh_token"] = data["refresh_token"]
        return updates, {}
    return refresh_credentials(
        path, entries[0], "key", "refresh_token",
        lambda c: (timestamp(c.get("expires_at")) or jwt_expiry(c["key"])) - time.time() <= 60,
        refresh, force,
    )["key"]


def parse_usage(payload):
    cfg = payload["config"]
    end = (cfg.get("currentPeriod") or {}).get("end") or cfg.get("billingPeriodEnd")
    if not end:
        raise ValueError("no billing period in response")
    return {
        # Protobuf JSON omits zero-valued numeric fields.
        "percent": percent(cfg.get("creditUsagePercent", 0)),
        "reset_at": timestamp(end),
    }


def fetch():
    return parse_usage(authenticated_json(
        "https://cli-chat-proxy.grok.com/v1/billing?format=credits",
        fresh_token, {"x-xai-token-auth": "xai-grok-cli"},
    ))


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "percent"
    if mode not in MODES:
        sys.exit(f"unknown mode: {mode}")
    print(render(load_cache(cache_path(), fetch), mode))


if __name__ == "__main__":
    main()
