#!/usr/bin/env python3
"""Codex weekly usage: codex-quota [profile] percent|remaining|days|color|status.

Named profiles use ~/.codex-<profile>. Only default honors CODEX_HOME;
overridden homes get a separate cache. Tokens refresh without starting a model.
"""
from datetime import datetime, timezone
import hashlib
import os
from pathlib import Path
import re
import sys
import time
from ai_quota_common import (
    MODES, authenticated_json, jwt_expiry, number, percent, read_json,
    refresh_credentials, request_json, run, timestamp,
)

WEEK = 604800
CLIENT_ID = "app_EMoamEEZ73f0CkXaXp7hrann"
TOKEN_URL = "https://auth.openai.com/oauth/token"


def codex_home(profile):
    if not re.fullmatch(r"[A-Za-z0-9_-]+", profile):
        raise ValueError("invalid profile")
    if profile == "default":
        return Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
    return Path.home() / f".codex-{profile}"


def cache_path(profile):
    source = codex_home(profile).resolve()
    suffix = ""
    if profile == "default" and source != (Path.home() / ".codex").resolve():
        suffix = "-" + hashlib.sha256(str(source).encode()).hexdigest()[:12]
    return Path.home() / ".cache" / f"codex-quota-{profile}{suffix}.json"


def fresh_token(profile, force=False):
    def refresh(tokens):
        data = request_json(TOKEN_URL, body={
            "client_id": CLIENT_ID, "grant_type": "refresh_token",
            "refresh_token": tokens["refresh_token"],
        })
        updates = {k: data[k] for k in ("access_token", "refresh_token", "id_token") if data.get(k)}
        return updates, {"last_refresh": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")}
    return refresh_credentials(
        codex_home(profile) / "auth.json", "tokens", "access_token", "refresh_token",
        lambda c: jwt_expiry(c["access_token"]) - time.time() <= 60,
        refresh, force,
    )["access_token"]


def split_windows(rl):
    found = [w for w in (rl.get("primary_window"), rl.get("secondary_window")) if isinstance(w, dict)]
    # Tolerate a few hours of rounding in the reported window length.
    weekly = next((w for w in found if abs(number(w.get("limit_window_seconds", 0)) - WEEK) < 10800), None)
    others = [w for w in found if w is not weekly and 0 < number(w.get("limit_window_seconds", 0)) < WEEK]
    short = min(others, key=lambda w: number(w["limit_window_seconds"])) if others else None
    return weekly, short


def window_reset(window, now):
    if window.get("reset_at") is not None:
        return timestamp(window["reset_at"])
    if window.get("reset_after_seconds") is not None:
        return now + max(0, number(window["reset_after_seconds"]))
    return None


def parse_usage(payload, now=None):
    now = time.time() if now is None else now
    weekly, short = split_windows(payload.get("rate_limit") or {})
    if weekly is None or "used_percent" not in weekly:
        raise ValueError("no weekly usage window in response")
    return {
        "percent": percent(weekly["used_percent"]),
        "reset_at": window_reset(weekly, now),
        "short_percent": percent(short.get("used_percent", 0)) if short else 0,
        "short_reset_at": window_reset(short, now) if short else None,
    }


def fetch(profile):
    tokens = read_json(codex_home(profile) / "auth.json")["tokens"]
    headers = {"ChatGPT-Account-Id": tokens["account_id"]} if tokens.get("account_id") else {}
    return parse_usage(authenticated_json(
        "https://chatgpt.com/backend-api/wham/usage",
        lambda force: fresh_token(profile, force), headers,
    ))


def main():
    args = sys.argv[1:]
    profile = args.pop(0) if args and args[0] not in MODES else "default"
    run(args[0] if args else "percent", cache_path(profile), lambda: fetch(profile))


if __name__ == "__main__":
    main()
