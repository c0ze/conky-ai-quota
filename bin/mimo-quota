#!/usr/bin/env python3
"""MiMo Token Plan usage: percent|remaining|days|color|status|fetch.

The plan's usage lives only in the platform console, behind a 24-hour
session cookie; the tp- API key cannot read it. This script mints that
cookie through the console's own SSO hop chain (serviceLogin -> /sts) from
the Xiaomi account login you save yourself, mode 600:

    ~/.config/mimo-quota/account.json   {"userId": "...", "passToken": "..."}

The account cookies are only ever sent to *.xiaomi.com. The minted console
cookie is kept in ~/.cache/mimo-quota-session.json until the console
rejects it.
"""
from datetime import datetime, timedelta, timezone
import json
from pathlib import Path
import sys
import urllib.error
import urllib.parse
import urllib.request
from ai_quota_common import USER_AGENT, number, percent, read_json, request_json, run, write_json

CONSOLE = "https://platform.xiaomimimo.com"
USAGE_PATH = "/api/v1/tokenPlan/usage"
DETAIL_PATH = "/api/v1/tokenPlan/detail"
ACCOUNT = Path.home() / ".config/mimo-quota/account.json"
SESSION = Path.home() / ".cache/mimo-quota-session.json"
CACHE = Path.home() / ".cache/mimo-quota.json"
TTL = 900
# The console prints period ends without a zone; the CN and SGP consoles
# both run on UTC+8.
CONSOLE_TZ = timezone(timedelta(hours=8))
SESSION_COOKIES = ("api-platform_serviceToken", "userId", "api-platform_slh", "api-platform_ph")
SSO_HOP_LIMIT = 8


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def set_cookies(headers):
    pairs = {}
    for value in headers.get_all("Set-Cookie") or []:
        name, sep, rest = value.split(";")[0].partition("=")
        if sep:
            pairs[name.strip()] = rest.strip()
    return pairs


def is_xiaomi(url):
    host = urllib.parse.urlparse(url).hostname or ""
    return host == "xiaomi.com" or host.endswith(".xiaomi.com")


def mint():
    """Follow the SSO chain the web client uses; return the console cookies."""
    account = read_json(ACCOUNT)
    account_cookie = f"userId={account['userId']}; passToken={account['passToken']}"
    opener = urllib.request.build_opener(_NoRedirect)
    headers = {"User-Agent": USER_AGENT, "Accept": "application/json"}
    try:  # an unauthenticated console call answers 401 carrying the loginUrl
        opener.open(urllib.request.Request(CONSOLE + USAGE_PATH, headers=headers), timeout=10).close()
        raise ValueError("console answered without a session")
    except urllib.error.HTTPError as error:
        if error.code != 401:
            raise
        url = str(json.loads(error.read()).get("loginUrl") or "")
        error.close()
    if not is_xiaomi(url):
        raise ValueError("unexpected loginUrl")

    minted = {}
    for _ in range(SSO_HOP_LIMIT):
        hop = {**headers, "Cookie": account_cookie} if is_xiaomi(url) else headers
        try:
            response = opener.open(urllib.request.Request(url, headers=hop), timeout=10)
        except urllib.error.HTTPError as error:
            response = error
        minted.update(set_cookies(response.headers))
        location = response.headers.get("Location")
        response.close()
        if not location:
            break
        url = urllib.parse.urljoin(url, location)
    if not minted.get("api-platform_serviceToken"):
        raise PermissionError("Xiaomi login rejected; renew ~/.config/mimo-quota/account.json")
    session = {k: v for k, v in minted.items() if k in SESSION_COOKIES}
    write_json(SESSION, session)
    return session


def console_get(path, session):
    cookie = "; ".join(f"{k}={v}" for k, v in session.items())
    body = request_json(CONSOLE + path, headers={"Cookie": cookie, "X-Requested-With": "XMLHttpRequest"})
    if body.get("code") not in (0, None) or not isinstance(body.get("data"), dict):
        raise ValueError("console error response")
    return body["data"]


def period_end(value):
    if not value:
        return None
    return datetime.strptime(value, "%Y-%m-%d %H:%M:%S").replace(tzinfo=CONSOLE_TZ).timestamp()


def parse_usage(usage, detail):
    # Token plans are monthly; `usage` (plan cycle) is the fallback when the
    # console stops reporting `monthUsage`. Both describe the same allowance.
    for block in (usage.get("monthUsage"), usage.get("usage")):
        items = (block or {}).get("items") or []
        item = next((i for i in items if number(i.get("limit", 0)) > 0), None)
        if item:
            return {
                "percent": percent(number(item.get("used", 0)) / number(item["limit"]) * 100),
                "reset_at": period_end(detail.get("currentPeriodEnd")),
            }
    raise ValueError("no token-plan window in response")


def fetch():
    try:
        session = read_json(SESSION)
    except (OSError, ValueError):
        session = mint()
    for attempt in (1, 2):
        try:
            return parse_usage(console_get(USAGE_PATH, session), console_get(DETAIL_PATH, session))
        except urllib.error.HTTPError as error:
            if error.code not in (401, 403) or attempt == 2:
                raise
            error.close()
            session = mint()  # the 24-hour console cookie expired


def main():
    run(sys.argv[1] if len(sys.argv) > 1 else "percent", CACHE, fetch, TTL)


if __name__ == "__main__":
    main()
