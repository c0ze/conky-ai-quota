[Desktop Entry]
Type=Application
Name=Conky
Comment=System monitor
# Adjust the path: desktop entries do not expand $HOME, and # is not a comment inside Exec=.
Exec=/home/USER/.config/conky/start-conky.sh
StartupNotify=false
Terminal=false
Hidden=false
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
