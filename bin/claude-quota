#!/usr/bin/env python3
"""Claude weekly usage: percent|remaining|days|color|status."""
import sys
import time
from pathlib import Path
from ai_quota_common import (
    authenticated_json, number, percent, refresh_credentials,
    request_json, run, timestamp,
)

CACHE = Path.home() / ".cache/claude-quota.json"
CREDS = Path.home() / ".claude/.credentials.json"
TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"


def fresh_token(force=False):
    def refresh(oauth):
        data = request_json(TOKEN_URL, body={
            "client_id": CLIENT_ID, "grant_type": "refresh_token",
            "refresh_token": oauth["refreshToken"],
        })
        updates = {
            "accessToken": data["access_token"],
            "expiresAt": int((time.time() + number(data.get("expires_in", 3600))) * 1000),
        }
        if data.get("refresh_token"):
            updates["refreshToken"] = data["refresh_token"]
        return updates, {}
    return refresh_credentials(
        CREDS, "claudeAiOauth", "accessToken", "refreshToken",
        lambda c: number(c.get("expiresAt", 0)) / 1000 - time.time() <= 60,
        refresh, force,
    )["accessToken"]


def parse_usage(payload):
    # Never substitute a session window for this weekly bar.
    weekly = payload.get("seven_day")
    if not isinstance(weekly, dict) or "utilization" not in weekly:
        raise ValueError("no weekly usage window in response")
    short = payload.get("five_hour") or {}
    return {
        "percent": percent(weekly["utilization"]),
        "reset_at": timestamp(weekly.get("resets_at")),
        "short_percent": percent(short.get("utilization", 0)),
        "short_reset_at": timestamp(short.get("resets_at")),
    }


def fetch():
    return parse_usage(authenticated_json(
        USAGE_URL, fresh_token, {"anthropic-beta": "oauth-2025-04-20"},
    ))


def main():
    run(sys.argv[1] if len(sys.argv) > 1 else "percent", CACHE, fetch)


if __name__ == "__main__":
    main()
