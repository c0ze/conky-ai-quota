#!/usr/bin/env python3
# Grok weekly quota for Conky. Usage: grok-quota percent|remaining
# Fetches https://cli-chat-proxy.grok.com/v1/billing?format=credits at most
# once per TTL seconds (cache in ~/.cache/grok-quota.json); on fetch failure
# serves the last good cache.
# NOTE: the access token expires in hours and only the `grok` CLI refreshes
# it. If this starts showing stale data, run `grok` once.

import json
import os
import sys
import time
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

TTL = 240  # seconds between network fetches
CACHE = Path.home() / ".cache" / "grok-quota.json"


def fetch() -> dict:
    grok_home = Path(os.environ.get("GROK_HOME", Path.home() / ".grok"))
    auth = json.loads((grok_home / "auth.json").read_text())
    token = next(iter(auth.values()))["key"]
    req = urllib.request.Request(
        "https://cli-chat-proxy.grok.com/v1/billing?format=credits",
        headers={
            "Authorization": f"Bearer {token}",
            "x-xai-token-auth": "xai-grok-cli",
            "Accept": "application/json",
        },
    )
    with urllib.request.urlopen(req, timeout=8) as resp:
        cfg = json.loads(resp.read())["config"]

    pct = cfg.get("creditUsagePercent") or 0  # proto3 omits zero
    end = (cfg.get("currentPeriod") or {}).get("end") or cfg.get("billingPeriodEnd") or ""
    secs = 0.0
    if end:
        dt = datetime.fromisoformat(end)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        secs = max(0.0, (dt - datetime.now(timezone.utc)).total_seconds())

    return {"percent": pct, "reset_secs": secs, "fetched_at": time.time()}


def load() -> dict | None:
    try:
        cached = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        cached = None

    if cached and time.time() - cached.get("fetched_at", 0) < TTL:
        return cached

    try:
        data = fetch()
    except Exception:
        return cached  # stale beats nothing

    CACHE.parent.mkdir(parents=True, exist_ok=True)
    CACHE.write_text(json.dumps(data))
    CACHE.chmod(0o600)
    return data


def fmt_remaining(secs: float) -> str:
    days, rem = divmod(int(secs), 86400)
    hours = rem // 3600
    if days >= 2:
        return f"{days} days to reset"
    if days == 1:
        return f"1 day {hours}h to reset"
    return f"{hours}h to reset"


def main() -> None:
    mode = sys.argv[1] if len(sys.argv) > 1 else "percent"
    data = load()

    if data is None:
        print(0 if mode == "percent" else "?")
        return

    if mode == "percent":
        print(f"{data['percent']:.0f}")
    elif mode == "remaining":
        print(fmt_remaining(data["reset_secs"]))
    elif mode == "days":
        secs = data["reset_secs"]
        days = int(secs // 86400)
        print(f"{days:02d}d" if days > 0 else f"{int(secs // 3600):02d}h")
    else:
        sys.exit(f"unknown mode: {mode}")


if __name__ == "__main__":
    main()
