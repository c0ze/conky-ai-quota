#!/usr/bin/env python3
"""Muse Code weekly usage: percent|remaining|days|color|status|fetch.

Meta exposes no usage endpoint: the subscription numbers ride only on a
model response, as a `response.subscription_usage` stream event. So each
fetch sends a tiny prompt with the CLI's stored key (~/.config/muse/auth.json,
or $MUSE_AUTH_PATH) and reads that event. TTL keeps it to one call per
30 minutes.
"""
import json
import os
from pathlib import Path
import sys
import urllib.request
from ai_quota_common import USER_AGENT, percent, read_json, run, timestamp

CACHE = Path.home() / ".cache/muse-quota.json"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "muse"
TTL = 1800  # every fetch is a real (tiny) model call
DEFAULT_MODEL = "muse-spark-1.3"


def auth_path():
    return Path(os.environ.get("MUSE_AUTH_PATH") or CONFIG / "auth.json")


def model():
    try:
        return read_json(CONFIG / "settings.json").get("model") or DEFAULT_MODEL
    except (OSError, ValueError):
        return DEFAULT_MODEL


def parse_usage(subscription):
    weekly = subscription.get("weekly")
    if not isinstance(weekly, dict) or "used_percent" not in weekly:
        raise ValueError("no weekly usage window in response")
    short = subscription.get("window") or {}
    return {
        "percent": percent(weekly["used_percent"]),
        "reset_at": timestamp(weekly.get("resets_at")),
        "short_percent": percent(short.get("used_percent", 0)),
        "short_reset_at": timestamp(short.get("resets_at")),
    }


def usage_event(lines):
    """The subscription block from a server-sent event stream."""
    for raw in lines:
        line = raw.decode(errors="replace").strip()
        if not line.startswith("data:"):
            continue
        try:
            event = json.loads(line[5:])
        except ValueError:
            continue
        if isinstance(event, dict) and event.get("type") == "response.subscription_usage":
            return event.get("subscription") or {}
    raise ValueError("no subscription usage in response")


def fetch():
    meta = read_json(auth_path())["providers"]["meta"]
    base = (meta.get("api_base_url") or "https://api.meta.ai/v1").rstrip("/")
    body = {"model": model(), "input": "Reply with: ok", "stream": True, "store": False,
            "max_output_tokens": 16, "reasoning": {"effort": "minimal"}}
    req = urllib.request.Request(f"{base}/responses", data=json.dumps(body).encode(), headers={
        "Authorization": f"Bearer {meta['api_key']}", "Content-Type": "application/json",
        "Accept": "text/event-stream", "User-Agent": USER_AGENT,
    })
    with urllib.request.urlopen(req, timeout=30) as response:
        return parse_usage(usage_event(response))


def main():
    run(sys.argv[1] if len(sys.argv) > 1 else "percent", CACHE, fetch, TTL)


if __name__ == "__main__":
    main()
